# PostgreSQL application role: CRUD only, never a superuser.
DATABASE_URL=postgresql://edu_app:change-me@localhost:5432/eduplatform?sslmode=disable

# PostgreSQL migration role: DDL privileges. Required in production.
MIGRATION_DATABASE_URL=postgresql://edu_migrator:change-me@localhost:5432/eduplatform?sslmode=disable

PORT=8080
APP_ENV=development
GIN_MODE=debug
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
JWT_ISSUER=eduplatform-api
JWT_AUDIENCE=eduplatform-web
# Comma-separated proxy CIDRs/IPs; leave empty when the API is reached directly.
TRUSTED_PROXIES=

# Development-only additive schema helper. Use `go run ./cmd/migrate up` normally.
AUTO_MIGRATE=false

# Fixtures are disabled automatically in production unless FORCE_SEED=true.
SKIP_SEED=true
FORCE_SEED=false
# SEED_PASSWORD=change-me
# SEED_TEST_STUDENTS=100
