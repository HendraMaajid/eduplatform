# PostgreSQL application role: CRUD only, never a superuser.
DATABASE_URL=postgresql://edu_app:change-me@localhost:5432/eduplatform?sslmode=disable

# PostgreSQL migration role: DDL privileges. Required in production.
MIGRATION_DATABASE_URL=postgresql://edu_migrator:change-me@localhost:5432/eduplatform?sslmode=disable

PORT=8080
APP_ENV=development
GIN_MODE=debug
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
JWT_ISSUER=eduplatform-api
JWT_AUDIENCE=eduplatform-web
# Comma-separated proxy CIDRs/IPs; leave empty when the API is reached directly.
TRUSTED_PROXIES=

# Development-only additive schema helper. Use `go run ./cmd/migrate up` normally.
AUTO_MIGRATE=false

# The default seed is disabled automatically in production unless FORCE_SEED=true.
# It creates platform settings, the fixed super admin account below, and the
# complete Java Dasar course. Use a unique local password; never commit it.
SKIP_SEED=true
FORCE_SEED=false
SEED_SUPER_ADMIN_NAME=Hendra Latief Ulum
SEED_SUPER_ADMIN_PASSWORD=replace-with-a-strong-local-password
